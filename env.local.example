# .env.local — Environment Variables untuk Project Confession Web App
# ============================================================
# CATATAN PENTING:
# - File ini isinya TEMPLATE dengan placeholder, bukan credential asli.
# - Isi manual sendiri nilai aslinya, JANGAN kirim credential asli ke chat AI manapun.
# - Setelah diisi, pastikan file .env.local ini ADA di .gitignore, jangan sampai ke-commit ke Git.
# - Variable dengan prefix NEXT_PUBLIC_ akan ter-expose ke browser (aman untuk anon/publishable key).
# - Variable TANPA prefix NEXT_PUBLIC_ hanya jalan di server/backend — WAJIB untuk semua secret/token.
# ============================================================

# ---- SUPABASE (Database) ----
# Ambil dari: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://bevlmzpotbsdywdymvny.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJldmxtenBvdGJzZHl3ZHltdm55Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg5NzQzNTMsImV4cCI6MjEwNDU1MDM1M30.TUWDq0Kc2a4BqGawnloAcfTQj9UJMyyjPajB9pgNAWo
# SUPABASE_SERVICE_ROLE_KEY (opsional jika RLS aktif & ingin server-side route leluasa read data)
SUPABASE_SERVICE_ROLE_KEY=isi_dengan_service_role_key_jika_ada


# ---- TELEGRAM BOT (Notifikasi jawaban) ----
# Bot token dari @BotFather. JANGAN pakai prefix NEXT_PUBLIC_ — ini harus tetap rahasia di server.
TELEGRAM_BOT_TOKEN=isi_dengan_token_dari_botfather
# Chat ID kamu sendiri, dari @userinfobot atau endpoint getUpdates
TELEGRAM_CHAT_ID=isi_dengan_chat_id_kamu

# ---- ADMIN PAGE (Proteksi halaman /admin) ----
# Password sederhana untuk halaman recap jawaban. Ganti dengan password kamu sendiri, jangan yang gampang ditebak.
ADMIN_PASSWORD=herfi106

# ---- SITE CONFIG (opsional, tapi berguna) ----
